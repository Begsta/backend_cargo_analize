{
  "info": {
    "name": "Лабораторная 4 — WOLFF — сессии и cookie",
    "description": "10 методов API, 17 сценариев проверки. Для гостевых проверок cookie jar отключён; в авторизованных вручную включён Cookie header. Указать настоящие файлы в запросе 05. Для переноса сессии из Swagger скопировать Application → Cookies → session_id в Variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "user_login",
      "value": "lab4_operator"
    },
    {
      "key": "user_password",
      "value": "Demo-password-2026"
    },
    {
      "key": "cookie_name",
      "value": "session_id"
    },
    {
      "key": "session_id",
      "value": ""
    },
    {
      "key": "cargo_id",
      "value": ""
    },
    {
      "key": "feed_cargo_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Регистрация с паролем",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users"
          ]
        },
        "description": "Подготовка. Если логин занят, изменить user_login в Variables. Регистрация сама не выполняет вход.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_login\": \"{{user_login}}\",\n  \"user_name\": \"Оператор лабораторной 4\",\n  \"user_password\": \"{{user_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 Вход — получить session_id",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/authentication",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "authentication"
          ]
        },
        "description": "Можно вместо этого войти в Swagger и вручную скопировать cookie из Application в переменную session_id. В ответе нет JWT: используется Redis-сессия.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"user_login\": \"{{user_login}}\",\n  \"user_password\": \"{{user_password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const header = pm.response.headers.get(\"Set-Cookie\") || \"\"; const pair = header.split(\";\")[0]; const index = pair.indexOf(\"=\"); if (index > 0) { pm.collectionVariables.set(\"cookie_name\", pair.slice(0,index)); pm.collectionVariables.set(\"session_id\", pair.slice(index+1)); } }"
            ]
          }
        }
      ],
      "response": []
    },
    {
